# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# Config / secrets — never commit (ARCHITECTURE.md decision #5)
# A pattern, not a list. config.prod.yml had to be added by hand when the first
# prod run arrived, and config.uat.yml was one `git add` away from committing
# live UAT credentials. Any config.<env>.yml holds secrets; config.yml.example
# does not match this and stays tracked.
config/config.yml
config/config.*.yml

# Run bundles + outputs
runs/
*.log

# Per-step logs from scripts/triage_pipeline.sh
logs/

# The Slack message is regenerated by every submit; Jenkins posts it straight
# after the run. A committed copy would be a stale claim about the last run.
slack/*.txt

# Signature-ledger observation log — a rebuildable cache, never committed.
state/
