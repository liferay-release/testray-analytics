# testray-analytics — config template.
# Copy to config/config.yml and fill in. NEVER commit config.yml.
#
# Same code runs local / UAT / prod — only this config differs
# (ARCHITECTURE.md decision #5): base_url + per-env credentials.
#
# base_url and the Testray secrets can also come from the ENVIRONMENT, which
# overrides the values here — TESTRAY_BASE_URL / TESTRAY_CLIENT_ID /
# TESTRAY_CLIENT_SECRET (keep them in your shell / Jenkins credentials and leave
# the fields below blank). ANTHROPIC_API_KEY is env-only.

git:
  # Persistent liferay-portal checkout (ARCHITECTURE.md §2 / §14). `prepare`
  # runs `git diff` and `git log A..B` between the two build hashes; it may
  # fetch if a hash is missing — from the ROUTINE's remote below, then origin.
  # On Jenkins this is a persistent workspace that `git pull`s each run —
  # never a fresh clone.
  # No branch setting needed: the diff is hash-to-hash (branch-agnostic); any
  # branch's build hashes work as long as they're reachable in this checkout.
  repo_path: /path/to/liferay-portal

  # Which repository each routine's builds are cut from, keyed by routine id.
  # This is a property of the ROUTINE, not of the tool, and the three differ:
  #
  #   Stable      brianchandotcom/liferay-portal   the CONTROL repo. Every
  #                                                commit merges here first, and
  #                                                a Stable failure blocks the
  #                                                sync to liferay/liferay-portal
  #                                                — so any failure has to be
  #                                                addressed or nobody in the
  #                                                organisation gets an updated
  #                                                upstream master.
  #   Acceptance  liferay/liferay-portal           master
  #   Release     liferay/liferay-portal-ee        release-202x.qy
  #
  # Values are git REMOTE names in the checkout at `repo_path`, not URLs, so
  # the credentials stay in the developer's or agent's git config.
  #
  # Without this, a commit missing from the local checkout is looked for on
  # `origin` — which for Stable is a personal fork that will never have it.
  # Runs then succeed only when the right branch happens to be fetched already,
  # which is not something an unattended scan on a fresh agent can rely on.
  # A routine with no entry falls back to `fetch_remote`, then to origin.
  routine_remotes:
    79529: bchan          # ci:test:stable — control repo
    590307: upstream      # EE Development Acceptance
    82964: upstream-ee    # release
  # Used for any routine not listed above. Leave unset to fall back to origin.
  #fetch_remote: bchan

testray:
  # Testray REST base_url (env override: TESTRAY_BASE_URL). Point at the instance
  # that HAS data — prod has real builds; a vanilla localhost does not:
  #   prod:       https://testray.liferay.com
  #   local DXP:  http://localhost:8080   (only once it's loaded with data)
  base_url: "https://testray.liferay.com"

  # OAuth2 client_credentials (env overrides: TESTRAY_CLIENT_ID /
  # TESTRAY_CLIENT_SECRET). Per-environment app: read scopes on
  # Build / Case / CaseResult, write scope on TriageResult. Never commit secrets.
  # Base URL of the Testray UI. Used ONLY for deep-links in report.html —
  # nothing in the pipeline calls it. Kept separate from base_url because the
  # UI sits under a site friendly URL that differs per instance, so it cannot
  # be derived. Leave unset and the report renders test names as plain text.
  #   local:  http://localhost:8080/web/liferay-testray
  #   prod:   https://testray.liferay.com/web/testray
  ui_url: "http://localhost:8080/web/liferay-testray"

  client_id: ""
  client_secret: ""

triage:

  # Extends prompt_helpers.DEFAULT_AUTO_CLASSIFY (merged, config wins).
  # Derived 2026-08-17 from the measured top clusters across builds
  # 36418/36420/36424 (2,083 failures). Effect: 36 -> 154 auto-classified
  # (7.4%); the other 1,929 still reach the classifier, which is correct —
  # ElementNotFound and TimeoutException dominate the corpus and are real
  # triage work, not noise.
  #
  # Every pattern here must be UNAMBIGUOUSLY infrastructure. A pattern that is
  # too broad routes a real regression into the auto bucket, where the write
  # inclusion policy then drops it from the store entirely — a silent loss with
  # nothing downstream to catch it. Deliberately NOT included:
  # "Login via API failed" — it overlaps net::ERR_NAME_NOT_RESOLVED on 84 of 95
  # rows, so it buys 11, and those 11 are logins that failed WITHOUT a network
  # error, i.e. possibly a genuine auth regression.
  # Testray components whose rows are CI infrastructure, not tests. Their
  # test_case is a batch name (functional-tomcat101-postgresql163/25/1), so
  # there is no test to match against the diff and no code to attribute to.
  # Rows are KEPT in the data and counted, but excluded from classification
  # (pre_classification=BATCH_FAILURE). Default: ["Batch"].
  excluded_components:
    - Batch

  auto_classify_patterns:
    BUILD_FAILURE:
      # The shipped default is "The build failed prior to running the test";
      # the text this data actually carries is "Failed prior to running test".
      - "[Ff]ailed prior to running (the )?test"
      - "marked build as failure"
    ENV_DEPENDENCY:
      # The frontend host does not resolve in this environment — DNS, not product.
      - "net::ERR_NAME_NOT_RESOLVED"
    ENV_SETUP:
      - "docker: 'docker rmi' requires at least 1 argument"
  classifier:
    api:
      # Classifier label is `api:<model>` and is model-version-pinned
      # (ARCHITECTURE.md decision #9). Bumping the model creates new rows
      # rather than overwriting — deliberate, for measurement.
      model: claude-opus-4-8
      effort: xhigh
      max_chars_per_batch: 400000
      max_output_tokens: 16000
      delay_between_batches_seconds: 2

# ANTHROPIC_API_KEY is passed via the environment, never stored here.

queue:
  # Pending attribution jobs, as marker files — the pattern liferay-docker uses
  # in templates/job-runner: a short cron REGISTERS work, a separate serial loop
  # drains it. Registering an already-pending job is a no-op, so a tick landing
  # while the previous job runs cannot stack duplicates up.
  #
  # Transient by design. There is no observation log and no watermark: whether a
  # failure has been dealt with is derived from Testray (a TriageResult carrying
  # its clusterKey), which is what keeps ARCHITECTURE decision #11 intact —
  # Testray stays the single sink. Losing this directory costs one re-queue on
  # the next tick, nothing more.
  #
  # Relative paths resolve against the PROJECT ROOT, never the current
  # directory, so the same value works whoever invokes the scanner and from
  # wherever. $TRIAGE_QUEUE overrides it — the seam to use when one machine runs
  # both a local experiment and the scheduled job.
  path: state/queue
